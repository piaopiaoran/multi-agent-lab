# ============================================================================
# 复制为 .env 后填写自己的值。.env 已被 .gitignore 排除，切勿提交真实密钥。
# 本项目所有配置都支持「零密钥档」：LLM_PROVIDER=fake + STORAGE_BACKEND=memory
# ============================================================================

# ---------- LangSmith（可观测性 / trace）----------
# 设为 false 可完全关闭上报；留空 key 时也会自动关闭
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=multi-agent-supervisor-demo
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------- LLM（OpenAI 兼容协议：DeepSeek / 硅基流动 / OpenAI 都能接）----------
# fake  = 确定性本地应答，零密钥零成本，用来跑通链路与测试（语义质量会退化）
# openai= 走 OpenAI 兼容 /chat/completions
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-flash
# 实测可用模型（/v1/models）：deepseek-flash（DeepSeek-V4.1-Flash，推理模型）、deepseek-v4-pro。
# 若接口返回 model not found，换成列表里存在的模型名即可，其余代码无需改动。
# DeepSeek V4 系列的 thinking mode 默认开启。带 tools 的多轮请求要求把之前
# 每一轮 assistant 的 reasoning_content 原样回传，否则 API 直接返回 400。
# disabled = 关闭思考（推荐：路由/工具调用场景更快更省，且 temperature 生效）
# enabled  = 保留思考（本项目已把子 Agent 产出折叠成 observation，可正常多轮）
LLM_THINKING=disabled
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=20000

# ---------- Embeddings（pgvector 的向量化）----------
# 注意：DeepSeek 只提供 chat 模型，不提供 embeddings，所以此处需单独选型。
# fake   = 本地确定性哈希向量，零成本，维度 1536，用于跑通检索链路
# openai = 走 OpenAI 兼容 /embeddings（如硅基流动 BAAI/bge-m3、OpenAI）
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536

# ---------- 存储层 ----------
# memory   = 纯 JS 内存实现，零外部依赖，开箱即跑
# postgres = 真实 PostgreSQL + pgvector（先执行 npm run db:up）
STORAGE_BACKEND=memory
CHECKPOINTER=memory
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supervisor_demo
PGVECTOR_TABLE=documents
CHECKPOINT_TABLE_PREFIX=supervisor_ckpt

# ---------- 图执行护栏 ----------
# supervisor 最大路由轮数，防止 LLM 在 worker 之间死循环
MAX_ROUNDS=8
# 单个 worker 内部 LLM<->tool 循环的最大迭代次数
MAX_TOOL_ITERATIONS=4
