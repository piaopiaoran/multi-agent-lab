# ------------------------------------------------------------------
# 复制为 .env 后按需修改。项目在「没有 key / 没有数据库」时会自动降级，
# 因此不填任何内容也能 `npm run demo` 跑通全链路。
# ------------------------------------------------------------------

# ---- LLM（兼容 OpenAI 协议的任意网关都可以，改 BASE_URL 即可）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
EMBEDDING_MODEL=text-embedding-3-small
# 向量维度必须与 db/schema.sql 中 vector(N) 一致；换模型要同时改两处
EMBEDDING_DIM=1536

# ---- PostgreSQL + pgvector ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/multi_agent_lab
# true = 连不上 PG 直接报错；false（默认）= 自动降级为内存 checkpointer / 内存向量库
PG_STRICT=false

# ---- 运行模式 ----
# auto（默认）：有 OPENAI_API_KEY 用真实模型，否则用可复现的 mock 模型
# live：强制真实模型（缺 key 直接报错）
# mock：强制 mock 模型，完全离线
AGENT_MODE=auto
# 默认演示的多 Agent 拓扑：supervisor | swarm | parallel
DEFAULT_GRAPH=supervisor
LOG_LEVEL=info

# ---- LangSmith 可观测性（可选；不填则完全不启用，也不发任何网络请求）----
# 在 smith.langchain.com → Settings → API Keys 生成
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-lab
# 账号区域不是 US 时改这里：EU https://eu.api.smith.langchain.com
# APAC https://apac.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# CLI / 单测设 false 保证退出前上报完成；长驻服务可设 true 降延迟
LANGCHAIN_CALLBACKS_BACKGROUND=false
