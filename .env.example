# ------------------------------------------------------------------
# 复制为 .env 后按需修改。项目在「没有 key / 没有数据库」时会自动降级，
# 因此不填任何内容也能 `npm run demo` 跑通全链路。
# ------------------------------------------------------------------

# ---- LLM（OpenAI 兼容协议，DeepSeek / 硅基流动 / OpenAI 都能接）----
# fake  = 确定性本地应答，零密钥零成本，用来跑通链路与测试（语义质量会退化）
# openai= 走 OpenAI 兼容 /chat/completions
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2
# 结构化路由按供应商自动推断：OpenAI → json_schema（严格模式），
# DeepSeek 等兼容网关 → json_object（实测不支持 json_schema / 强制 tool_choice）
# 需要覆盖时显式设置：LLM_STRUCTURED_OUTPUT=json_object|json_schema
# DeepSeek 默认关闭 thinking（多轮 ReAct 回传 reasoning_content 会被 400 拒绝）；
# 想开思考模式可设 LLM_DISABLE_THINKING=false，但需自行处理多轮回传
# 兼容旧写法：不写 LLM_API_KEY / LLM_BASE_URL 时仍会读 OPENAI_API_KEY / OPENAI_BASE_URL

# ---- Embedding（与 chat 网关解耦，避免打到不存在的 /embeddings）----
# mock = 本地哈希向量（默认，零成本）/ openai = 真实向量模型
EMBEDDING_PROVIDER=mock
# 接真实向量模型时单独填这两项，不要复用 DeepSeek 的 key
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# 向量维度必须与 db/schema.sql 中 vector(N) 一致；换模型要同时改两处
EMBEDDING_DIM=1536

# ---- PostgreSQL + pgvector ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/multi_agent_lab
# true = 连不上 PG 直接报错；false（默认）= 自动降级为内存 checkpointer / 内存向量库
PG_STRICT=false

# ---- 运行时强制开关（优先级高于 LLM_PROVIDER，一般不用填）----
# AGENT_MODE=mock npm run demo → 强制离线，不发起任何模型请求（单测 / CI 也用它）
# AGENT_MODE=live npm run demo → 强制真实模型，缺 key 直接报错
# 不设置时由 LLM_PROVIDER 决定；两者都没填则「有 key 自动 live，无 key 自动 fake」
# AGENT_MODE=auto
# 默认演示的多 Agent 拓扑：supervisor | swarm | parallel
DEFAULT_GRAPH=supervisor
LOG_LEVEL=info

# ---- LangSmith 可观测性（可选；不填则完全不启用，也不发任何网络请求）----
# 在 smith.langchain.com → Settings → API Keys 生成
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-lab
# 账号区域不是 US 时改这里：EU https://eu.api.smith.langchain.com
# APAC https://apac.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# CLI / 单测设 false 保证退出前上报完成；长驻服务可设 true 降延迟
LANGCHAIN_CALLBACKS_BACKGROUND=false
