{
  "name": "multi-agent-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "面试向多 Agent 实验项目：LangChain + LangGraph + PostgreSQL/pgvector",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "init:db": "node src/scripts/init-db.js",
    "seed": "node src/scripts/seed.js",
    "demo": "node src/scripts/demo.js",
    "demo:supervisor": "node src/scripts/demo.js --graph=supervisor",
    "demo:swarm": "node src/scripts/demo.js --graph=swarm",
    "demo:parallel": "node src/scripts/demo.js --graph=parallel",
    "serve": "node src/server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@langchain/core": "^1.4.2",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.4",
    "@langchain/openai": "^1.8.4",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
